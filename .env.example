# =====================================================================
# Firebase Client Configuration (public)
# =====================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDUMMYREPLACE_WITH_REAL_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcd12
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABCDEFGH12

# =====================================================================
# Firebase Admin SDK (server-side, keep secret)
#
# HOW TO GET THIS:
#   1. Go to Firebase Console → Project Settings → Service Accounts
#   2. Click "Generate New Private Key" → download JSON file
#   3. Copy the ENTIRE JSON content and paste it as ONE LINE below
#   4. The private_key field will have \n — that's OK, the code handles it
#
# IMPORTANT: This must be the FULL JSON from the downloaded file,
# not placeholders. A real key is ~2500 characters long.
# =====================================================================
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"dummyprivatekeyid","private_key":"-----BEGIN PRIVATE KEY-----\\nREPLACE_WITH_REAL_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-abc12@your-project-id.iam.gserviceaccount.com","client_id":"123456789012345678901","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-abc12%40your-project-id.iam.gserviceaccount.com"}

# =====================================================================
# Mailchimp Newsletter
# Use your Audience form action URL (currently referenced from config).
# =====================================================================
MAILCHIMP_FORM_ACTION=https://example.us1.list-manage.com/subscribe/post?u=aaaaaaaaaaaaaaaaaaaaaaaaa&id=bbbbbbbbbb

# =====================================================================
# Admin Authentication
# ADMIN_PASSWORD is currently used as both login password and JWT signing secret.
# =====================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_long_random_secret

# =====================================================================
# Password for protected pages/routes
# =====================================================================
PAGE_ACCESS_PASSWORD=change_this_page_password

# =====================================================================
# Supabase (client-side uploads)
# NOTE: URL must include protocol, e.g. https://xyzcompany.supabase.co
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
NEXT_PUBLIC_SUPABASE_BUCKET=portfolio-images
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# =====================================================================
# ImgBB (client/public key if used in browser flows)
# =====================================================================
NEXT_PUBLIC_IMGBB_API_KEY=replace_with_imgbb_public_api_key

# =====================================================================
# Distributed Rate Limit (Upstash Redis REST)
# Used by /api/admin/auth login brute-force protection.
# =====================================================================
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token
